# Dev server port (Create React App). Match this in Google Maps HTTP referrer restrictions.
PORT=3000

# Copy to .env and fill in values from Supabase Dashboard → Settings → API.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Required for clinic sign-up and driver registration in the portal.
REACT_APP_SUPABASE_SERVICE_ROLE_KEY=

# Google Maps / Places (dispatch address search).
REACT_APP_GOOGLE_MAPS_API_KEY=
# Optional: vector map ID from Google Cloud → Map Management (closer to maps.google.com detail).
REACT_APP_GOOGLE_MAP_ID=
